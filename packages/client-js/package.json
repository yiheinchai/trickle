{
  "name": "trickle-observe",
  "version": "0.2.141",
  "description": "Runtime type capture for JavaScript/TypeScript. Use node -r trickle/observe to record argument, return, and variable types for VS Code and the CLI.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./register": "./register.js",
    "./observe": "./observe.js",
    "./observe-esm": "./observe-esm.mjs",
    "./trace-var": "./dist/trace-var.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "optionalDependencies": {
    "esbuild": "^0.27.4"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  },
  "keywords": [
    "types",
    "runtime",
    "typescript",
    "javascript",
    "inference"
  ],
  "license": "MIT"
}
