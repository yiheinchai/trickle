{
  "name": "trickle-cli",
  "version": "0.1.230",
  "description": "Runtime type annotations for Python and JavaScript — see tensor shapes, variable types, and crash-time values as you code",
  "keywords": [
    "runtime-types",
    "type-annotations",
    "python",
    "javascript",
    "typescript",
    "vscode",
    "jupyter",
    "tensors",
    "inlay-hints"
  ],
  "bin": {
    "trickle": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsc --noEmit",
    "dev": "ts-node src/index.ts"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "cli-table3": "^0.6.5",
    "commander": "^12.0.0",
    "trickle-observe": "^0.2.25"
  },
  "devDependencies": {
    "ts-node": "^10.9.0",
    "typescript": "^5.4.0"
  }
}
